# All variables are optional — the site works without any of them.

# Canonical URL used for SEO, sitemap and Open Graph (e.g. your custom domain).
# On Vercel this falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=

# GitHub token (no scopes needed) — raises the GitHub API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Contact form email delivery via Resend (https://resend.com, free tier).
# Without RESEND_API_KEY the form opens the visitor's email app instead.
RESEND_API_KEY=
# Defaults to the email in src/content/profile.ts
CONTACT_TO_EMAIL=
# Defaults to Resend's test sender; set this after verifying your own domain in Resend.
CONTACT_FROM_EMAIL=
